{
  "name": "yambl",
  "displayName": "YAMBL",
  "description": "YAMBL highlighting and a self-contained language server.",
  "version": "0.1.33",
  "publisher": "gokurakujoudo",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.cjs",
  "activationEvents": ["onLanguage:yambl", "onLanguage:yaplan", "onLanguage:yatran"],
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": true }, "virtualWorkspaces": false },
  "repository": {
    "type": "git",
    "url": "https://github.com/gokurakujoudo/yambl.git"
  },
  "contributes": {
    "commands": [
      { "command": "yambl.selectTransactionModel", "title": "YAMBL: Select Transaction Model Directory", "enablement": "editorLangId == yaplan || editorLangId == yatran" },
      { "command": "yambl.clearTransactionModel", "title": "YAMBL: Clear Transaction Model Binding", "enablement": "editorLangId == yaplan || editorLangId == yatran" }
    ],
    "configurationDefaults": {
      "[yaplan]": { "editor.defaultFormatter": "gokurakujoudo.yambl" },
      "[yatran]": { "editor.defaultFormatter": "gokurakujoudo.yambl" },
      "[yambl]": {
        "editor.defaultFormatter": "gokurakujoudo.yambl",
        "editor.semanticHighlighting.enabled": true,
        "editor.gotoLocation.alternativeDefinitionCommand": "editor.action.referenceSearch.trigger"
      }
    },
    "semanticTokenTypes": [
      { "id": "yamblValueType", "superType": "type", "description": "YAMBL value types and Decodes instances." }
    ],
    "semanticTokenScopes": [
      { "language": "yambl", "scopes": { "yamblValueType": ["support.type.yambl"] } }
    ],
    "languages": [
      {
        "id": "yambl",
        "aliases": ["YAMBL", "yambl"],
        "extensions": [".yambl"],
        "configuration": "./language-configuration.json"
      },
      { "id": "yaplan", "aliases": ["YAPLAN", "yaplan"], "extensions": [".yaplan"], "configuration": "./transaction-configuration.json" },
      { "id": "yatran", "aliases": ["YATRAN", "yatran"], "extensions": [".yatran"], "configuration": "./transaction-configuration.json" }
    ],
    "grammars": [
      {
        "language": "yambl",
        "scopeName": "source.yambl",
        "unbalancedBracketScopes": ["keyword.operator"],
        "path": "./syntaxes/yambl.tmLanguage.json"
      },
      { "language": "yaplan", "scopeName": "source.yaplan", "path": "./syntaxes/yaplan.tmLanguage.json" },
      { "language": "yatran", "scopeName": "source.yatran", "path": "./syntaxes/yatran.tmLanguage.json" }
    ]
  }
}
