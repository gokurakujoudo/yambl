{
  "name": "yambl",
  "displayName": "YAMBL",
  "description": "Syntax highlighting for Yet Another Model-Based Language.",
  "version": "0.0.1",
  "publisher": "gokurakujoudo",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "repository": {
    "type": "git",
    "url": "https://github.com/gokurakujoudo/yambl.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "yambl",
        "aliases": ["YAMBL", "yambl"],
        "extensions": [".yambl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yambl",
        "scopeName": "source.yambl",
        "path": "./syntaxes/yambl.tmLanguage.json"
      }
    ]
  }
}
