{
  "name": "yambl",
  "displayName": "YAMBL",
  "description": "YAMBL highlighting and a self-contained language server.",
  "version": "0.1.0",
  "publisher": "gokurakujoudo",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.cjs",
  "activationEvents": ["onLanguage:yambl"],
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": true }, "virtualWorkspaces": false },
  "repository": {
    "type": "git",
    "url": "https://github.com/gokurakujoudo/yambl.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "yambl",
        "aliases": ["YAMBL", "yambl"],
        "extensions": [".yambl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yambl",
        "scopeName": "source.yambl",
        "path": "./syntaxes/yambl.tmLanguage.json"
      }
    ]
  }
}
